# ==========================================
# Local Development Configuration
# ==========================================
PORT=3000
HEADLESS=false
TIMEZONE=Asia/Kolkata
SCHEDULE_TIME=09:00
BROWSER_PROFILE_DIR=.browser_profile
DATABASE_PATH=data/articles.db
AWS_BUILDER_BASE_URL=https://builder.aws.com/

# Optional: Gemini API key for AI-enhanced comments (falls back to smart extractive comments if empty)
GEMINI_API_KEY=

# ==========================================
# Render.com Cloud Hosting Configuration
# (Set these in the Render Environment Variables tab)
# ==========================================
# PORT=10000
# HEADLESS=true
# TIMEZONE=Asia/Kolkata
# SCHEDULE_TIME=09:00
# BROWSER_PROFILE_DIR=/var/data/.browser_profile
# DATABASE_PATH=/var/data/articles.db
